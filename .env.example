# Azure DevOps Server (on-prem) connection — local (stdio) mode
# Base URL of the on-prem server, e.g. https://devops.corp.local/tfs
ADO_SERVER_URL=

# Collection (defaults to DefaultCollection)
ADO_COLLECTION=DefaultCollection

# Raw Personal Access Token. NEVER commit a real value.
# In hosted (HTTP) mode this is NOT set here — clients send the X-ADO-PAT header per request.
ADO_PAT=

# REST API version (on-prem server build dependent). Default 7.1
ADO_API_VERSION=7.1

# Optional default project
ADO_DEFAULT_PROJECT=

# Comma-separated domains to enable (default: all)
# core,work,work-items,repositories,pipelines,wiki,test-plans
ADO_DOMAINS=

# Hosted (HTTP) mode options
# Bind address: 127.0.0.1 for local; set to an internal interface (e.g. 0.0.0.0 in a container) for hosted
ADO_HTTP_HOST=127.0.0.1
ADO_HTTP_PORT=3000
# Comma-separated Origin allowlist for browser clients (DNS-rebinding defense); empty allows no-Origin clients
ADO_ALLOWED_ORIGINS=
ADO_TLS_CERT=
ADO_TLS_KEY=

# Tuning
ADO_PAGE_SIZE=50
ADO_MAX_RESULTS=200
ADO_TIMEOUT_MS=30000
ADO_LOG_LEVEL=info
